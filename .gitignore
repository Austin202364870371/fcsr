.env
__pycache__/
*.py[cod]

# Generated data stays local. Every manifest remains visible to Git regardless
# of its depth so dataset provenance and counts can be reviewed and committed.
data/**
!data/**/
!data/**/manifest.json

checkpoints/
reports/
models/
logs/*
!logs/.gitkeep
.cache/
.vscode/
env-qgen/
docs/*
!docs/README.md
!docs/rq1-skill-retrieval.md
!docs/rq3-agent-planning.md
!docs/rq4-agent-reflection.md
!docs/rq5-agent-evaluation.md
# Track lightweight system metadata without tracking model weights.
checkpoints/**
!checkpoints/
!checkpoints/fcsr/
!checkpoints/fcsr/manifest.json
!checkpoints/fcsr-small/
!checkpoints/fcsr-small/manifest.json
